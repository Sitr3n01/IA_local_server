{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "cia-local-canary/gemma4-12b-qat-ud-q4xl-256k",
    "enabled_providers":  [
                              "cia-local-canary"
                          ],
    "share":  "disabled",
    "provider":  {
                     "cia-local-canary":  {
                                              "npm":  "@ai-sdk/openai-compatible",
                                              "name":  "CIA Local AI (canary)",
                                              "options":  {
                                                              "baseURL":  "http://127.0.0.1:18090/v1",
                                                              "apiKey":  "{env:CIA_LOCAL_API_KEY}"
                                                          },
                                              "models":  {
                                                             "gemma4-12b-qat-ud-q4xl-256k":  {
                                                                                                 "name":  "Gemma 4 12B QAT | UD-Q4_K_XL | 256k context",
                                                                                                 "tool_call":  false,
                                                                                                 "reasoning":  true,
                                                                                                 "attachment":  false,
                                                                                                 "limit":  {
                                                                                                               "context":  262144,
                                                                                                               "output":  8192
                                                                                                           }
                                                                                             },
                                                             "qwen38-27b-deep-32k":  {
                                                                                         "name":  "Qwen 3.8 27B | UD-IQ4_XS | 32k context",
                                                                                         "tool_call":  true,
                                                                                         "reasoning":  true,
                                                                                         "attachment":  false,
                                                                                         "limit":  {
                                                                                                       "context":  32768,
                                                                                                       "output":  8192
                                                                                                   }
                                                                                     },
                                                             "qwen38-27b-agent-128k":  {
                                                                                           "name":  "Qwen 3.8 27B | UD-Q3_K_XL | 128k context",
                                                                                           "tool_call":  true,
                                                                                           "reasoning":  true,
                                                                                           "attachment":  false,
                                                                                           "limit":  {
                                                                                                         "context":  131072,
                                                                                                         "output":  8192
                                                                                                     }
                                                                                       },
                                                             "qwen36-35b-a3b-huge-256k":  {
                                                                                              "name":  "Qwen 3.6 35B-A3B | UD-Q2_K_XL | 256k context",
                                                                                              "tool_call":  false,
                                                                                              "reasoning":  true,
                                                                                              "attachment":  false,
                                                                                              "limit":  {
                                                                                                            "context":  262144,
                                                                                                            "output":  16384
                                                                                                        }
                                                                                          }
                                                         }
                                          }
                 },
    "mcp":  {
                "cia-local-canary":  {
                                         "type":  "local",
                                         "command":  [
                                                         "C:\\IA\\local-ai-v2\\bin\\cia-mcp.exe"
                                                     ],
                                         "enabled":  true,
                                         "timeout":  10000,
                                         "environment":  {
                                                             "CIA_CONTROL_URL":  "http://127.0.0.1:18091"
                                                         }
                                     }
            }
}
