{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "cia-local/gemma4-12b-qat-ud-q4xl",
    "enabled_providers":  [
                              "cia-local"
                          ],
    "share":  "disabled",
    "provider":  {
                     "cia-local":  {
                                       "npm":  "@ai-sdk/openai-compatible",
                                       "name":  "CIA Local AI",
                                       "options":  {
                                                       "baseURL":  "http://127.0.0.1:8090/v1",
                                                       "apiKey":  "{env:CIA_LOCAL_API_KEY}"
                                                   },
                                       "models":  {
                                                      "gemma4-12b-qat-ud-q4xl":  {
                                                                                     "name":  "Gemma 4 12B QAT UD Q4_K_XL - 128k context",
                                                                                     "limit":  {
                                                                                                   "context":  131072,
                                                                                                   "output":  8192
                                                                                               }
                                                                                 },
                                                      "qwen38-27b-deep-32k":  {
                                                                                  "name":  "Qwen3.8 Deep 32k - IQ4_XS / KV q8_0 - hardest localized tasks",
                                                                                  "limit":  {
                                                                                                "context":  32768,
                                                                                                "output":  8192
                                                                                            }
                                                                              },
                                                      "qwen38-27b-agent-128k":  {
                                                                                    "name":  "Qwen3.8 Agent 128k - Q3_K_XL / KV q4_0 - daily agentic coding",
                                                                                    "limit":  {
                                                                                                  "context":  131072,
                                                                                                  "output":  8192
                                                                                              }
                                                                                },
                                                      "qwen38-27b-huge-256k":  {
                                                                                   "name":  "Qwen3.8 Huge 256k - Q2_K_XL / KV q4_0 - huge context, high thinking budget",
                                                                                   "limit":  {
                                                                                                 "context":  262144,
                                                                                                 "output":  32768
                                                                                             }
                                                                               }
                                                  }
                                   }
                 },
    "mcp":  {
                "cia-local":  {
                                  "type":  "local",
                                  "command":  [
                                                  "C:\\IA\\local-ai-v2\\bin\\cia-mcp.exe"
                                              ],
                                  "enabled":  true,
                                  "timeout":  10000,
                                  "environment":  {
                                                      "CIA_CONTROL_URL":  "http://127.0.0.1:8091"
                                                  }
                              }
            }
}
