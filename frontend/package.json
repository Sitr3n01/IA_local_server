{
  "name": "cia-console",
  "private": true,
  "version": "0.1.0",
  "description": "IA Local operator console (React + TypeScript), hosted inside cia-console.exe via WebView2.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input && npm run lint:monitor",
    "lint:monitor": "node scripts/lint-monitor.mjs",
    "test": "vitest run",
    "test:monitor": "node --test scripts/monitor-ui.test.mjs",
    "test:watch": "vitest",
    "verify:prod-bundle": "node scripts/verify-prod-bundle.mjs",
    "lint:report": "eslint . -f json -o reports/eslint/eslint.json || exit 0",
    "test:coverage:ci": "vitest run --coverage",
    "duplication:ci": "jscpd src --reporters json --output reports/duplication --min-lines 5 --min-tokens 50",
    "complexity:ci": "eslint src --config quality/eslint.complexity.mjs -f json -o reports/complexity/eslint-complexity.json || exit 0",
    "audit:report": "node scripts/quality/audit.mjs",
    "quality:collect": "npm run lint:report && npm run test:coverage:ci && npm run duplication:ci && npm run complexity:ci && npm run audit:report",
    "quality:report": "node scripts/quality/collect.mjs",
    "quality:check": "node scripts/quality/check.mjs",
    "quality:baseline": "node scripts/quality/baseline.mjs",
    "quality:gate": "npm run quality:collect && npm run quality:check"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@tanstack/react-query": "^5.102.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jscpd": "^4.3.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
