{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/cia-local-ai/models.schema.json",
  "title": "CIA Local AI model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "dependencies",
    "runtimes",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_model",
        "max_loaded_models"
      ],
      "properties": {
        "public_model": {
          "$ref": "#/$defs/id"
        },
        "max_loaded_models": {
          "const": 1
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llama_swap"
      ],
      "properties": {
        "llama_swap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "release_url",
            "archive_name",
            "archive_sha256",
            "executable_sha256",
            "install_path"
          ],
          "properties": {
            "version": {
              "const": "v240"
            },
            "release_url": {
              "type": "string",
              "format": "uri"
            },
            "archive_name": {
              "type": "string",
              "minLength": 1
            },
            "archive_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "install_path": {
              "$ref": "#/$defs/windows_path"
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtime"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "git_revision": {
      "type": "string",
      "$comment": "A full 40-hex commit. Branch and tag names (master, main, latest, HEAD) cannot match, so a runtime can never be pinned to a moving reference.",
      "pattern": "^[0-9a-f]{40}$"
    },
    "github_repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "runtime_provenance": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Identity of a runtime that is not an upstream release build. The runtime is identified by repository + commit + artifact SHA-256 + backend + GPU target, never by the directory it was unpacked into.",
      "required": [
        "source_repository",
        "source_revision",
        "checkpoint_fix",
        "build"
      ],
      "properties": {
        "source_repository": {
          "$ref": "#/$defs/github_repository"
        },
        "source_revision": {
          "$ref": "#/$defs/git_revision"
        },
        "upstream_base": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "Ancestry in ggml-org/llama.cpp, when the fork records a merge base. Optional because a fork may not publish one.",
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/github_repository"
            },
            "revision": {
              "$ref": "#/$defs/git_revision"
            },
            "version_label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checkpoint_fix": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "Evidence that the pinned commit implements the hybrid/recurrent context-checkpoint correction, recorded by cia-fork-gate rather than asserted by hand.",
          "required": [
            "reference",
            "evidence",
            "verified_utc",
            "gate_report_sha256"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*/(pull|issues)/[0-9]+$"
            },
            "evidence": {
              "enum": [
                "identical-patch",
                "semantic-equivalent"
              ]
            },
            "verified_utc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "gate_report_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "gpu_targets",
            "configuration",
            "targets"
          ],
          "properties": {
            "backend": {
              "const": "ROCm"
            },
            "gpu_targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^gfx[0-9a-f]+$"
              }
            },
            "configuration": {
              "const": "Release"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "$comment": "Only the server binary is built. A wider target list would grow the artifact without serving this deployment.",
              "items": {
                "const": "llama-server"
              }
            },
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "rocm_version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "windows_path": {
      "type": "string",
      "$comment": "The trailing class refuses control characters anywhere in the path. A generator that mishandles backslash escaping can embed CR or BS and still produce a string that looks like a drive-rooted path; the manifest then validates and llama-server fails at load with an error that names a path the operator cannot see is wrong.",
      "pattern": "^[A-Za-z]:\\\\[^\\x00-\\x1f]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/windows_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "engine",
        "version_label",
        "build_commit",
        "artifact",
        "device",
        "environment"
      ],
      "$comment": "engine stays llama.cpp for a fork that preserves the llama-server interface; variant is what distinguishes an upstream release build from a source-built fork.",
      "allOf": [
        {
          "if": {
            "properties": {
              "variant": {
                "const": "fork"
              }
            },
            "required": [
              "variant"
            ]
          },
          "then": {
            "required": [
              "provenance"
            ]
          }
        },
        {
          "if": {
            "required": [
              "provenance"
            ]
          },
          "then": {
            "required": [
              "variant"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "candidate",
            "qualified",
            "enabled",
            "retired"
          ]
        },
        "engine": {
          "const": "llama.cpp"
        },
        "variant": {
          "enum": [
            "upstream",
            "fork"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/runtime_provenance"
        },
        "version_label": {
          "type": "string",
          "minLength": 1
        },
        "build_commit": {
          "type": "string",
          "minLength": 7
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "selector",
            "gpu"
          ],
          "properties": {
            "backend": {
              "const": "ROCm"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "gpu": {
              "type": "string",
              "minLength": 1
            },
            "vram_mib": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "filename",
        "license"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40}$"
        },
        "filename": {
          "type": "string",
          "pattern": "\\.[Gg][Gg][Uu][Ff]$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec_decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "draft_n_max"
      ],
      "properties": {
        "type": {
          "enum": [
            "draft-mtp"
          ]
        },
        "draft_n_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "tensor_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "buffer"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S+$"
        },
        "buffer": {
          "enum": [
            "CPU"
          ]
        }
      }
    },
    "moe_offload": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Typed normal path for llama.cpp MoE expert placement. cpu_layers emits --n-cpu-moe N; cpu_all=true emits --cpu-moe. Tensor-specific -ot overrides remain available separately for advanced placement.",
      "oneOf": [
        {
          "required": [
            "cpu_layers"
          ]
        },
        {
          "required": [
            "cpu_all"
          ]
        }
      ],
      "properties": {
        "cpu_layers": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_all": {
          "const": true
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses",
        "chat_completions",
        "streaming",
        "function_calling",
        "structured_output"
      ],
      "properties": {
        "responses": {
          "type": "boolean"
        },
        "chat_completions": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "function_calling": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_vram_gib",
        "peak_commit_gib",
        "peak_ram_gib"
      ],
      "properties": {
        "peak_vram_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_commit_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_ram_gib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "state",
        "deployments",
        "runtime",
        "artifact",
        "source",
        "context_tokens",
        "max_output_tokens",
        "cache_type_k",
        "cache_type_v",
        "parallel",
        "batch_size",
        "ubatch_size",
        "gpu_layers",
        "jinja",
        "reasoning",
        "capabilities",
        "resources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "candidate",
            "qualified",
            "enabled",
            "retired"
          ]
        },
        "deployments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "canary",
              "final"
            ]
          }
        },
        "runtime": {
          "$ref": "#/$defs/id"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1024
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "n_predict": {
          "type": "integer",
          "minimum": -1,
          "$comment": "Server-side hard ceiling on generated tokens, emitted as --n-predict. -1 is llama-server's unrestricted default. Distinct from max_output_tokens, which is the contract advertised to the harness: this one the harness cannot exceed. Omitted, no flag is emitted and the command line is unchanged."
        },
        "reasoning_budget": {
          "type": "integer",
          "minimum": -1,
          "$comment": "Tokens a thinking model may spend before the answer must begin, emitted as --reasoning-budget. -1 unrestricted, 0 ends thinking immediately. Measured motivation: at an 8192-token ceiling with reasoning unrestricted, Qwen3.8-27B spent the whole budget inside reasoning_content and returned an empty answer on 3 of 10 coding tasks at Q2_K_XL and 1 of 10 at Q3_K_XL."
        },
        "reasoning_budget_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "$comment": "Injected before the end-of-thinking tag when reasoning_budget is exhausted, emitted as --reasoning-budget-message. Only meaningful alongside a positive reasoning_budget."
        },
        "compact_threshold_tokens": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Harness contract, not a server flag. The input size at which the harness must compact, derived as context_tokens - max_output_tokens - a safety margin so that generation always has room. Consumed by New-V2ClientCatalogs.ps1 to emit a per-model compaction threshold instead of one global percentage."
        },
        "cache_type_k": {
          "type": "string",
          "minLength": 1
        },
        "cache_type_v": {
          "type": "string",
          "minLength": 1
        },
        "parallel": {
          "const": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "ubatch_size": {
          "type": "integer",
          "minimum": 1,
          "$comment": "65..256 is a measured throughput collapse (up to 40x) on hybrid Gated DeltaNet models; the band is refused declaratively so no manifest can select it.",
          "not": {
            "type": "integer",
            "minimum": 65,
            "maximum": 256
          }
        },
        "gpu_layers": {
          "type": "integer",
          "minimum": 0
        },
        "jinja": {
          "const": true
        },
        "reasoning": {
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "context_shift": {
          "type": "boolean"
        },
        "kv_unified": {
          "type": "boolean"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "threads_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "cache_ram_mib": {
          "type": "integer",
          "minimum": 0
        },
        "ctx_checkpoints": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_min_step": {
          "type": "integer",
          "minimum": 0
        },
        "cache_idle_slots": {
          "type": "boolean"
        },
        "spec_decoding": {
          "$ref": "#/$defs/spec_decoding"
        },
        "moe_offload": {
          "$ref": "#/$defs/moe_offload"
        },
        "tensor_overrides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tensor_override"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    }
  }
}
