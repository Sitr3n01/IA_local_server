# Line endings are normalized to LF in the repository and in every working tree.
#
# CI runs on windows-latest, where Git's default core.autocrlf would rewrite
# checked-out files to CRLF. Several validation scripts parse harness configs
# with line-anchored regular expressions, so a CRLF checkout silently changes
# what those assertions match. Pinning eol=lf keeps CI byte-identical to a
# developer working tree. PowerShell, Go, and the Windows runtime all read LF
# without issue.
* text=auto eol=lf

*.ico binary
*.png binary
*.gguf binary
*.safetensors binary
*.exe binary
*.zip binary
*.bin binary

# Recorded evaluation evidence is machine-generated: GitHub collapses it in
# diffs and leaves it out of the repository's language statistics. The campaign
# drivers (*.ps1, *.py, *.sh) and reports (*.md) beside it stay visible.
benchmarks/**/*.json linguist-generated=true
benchmarks/**/*.jsonl linguist-generated=true
benchmarks/**/*.txt linguist-generated=true
benchmarks/**/*.stdout linguist-generated=true
benchmarks/**/*.out linguist-generated=true
benchmarks/**/*.DONE linguist-generated=true
# Code the models wrote while solving the coding fixtures.
benchmarks/**/work-*/** linguist-generated=true
